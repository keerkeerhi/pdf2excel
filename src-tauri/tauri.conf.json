{
    "$schema": "https://schema.tauri.app/config/2",
    "productName": "PDF 表格工坊",
    "version": "0.1.3",
    "identifier": "com.pdf2excel.workshop",
    "build": {
        "beforeDevCommand": "npm run dev",
        "devUrl": "http://localhost:1420",
        "beforeBuildCommand": "npm run build",
        "frontendDist": "../dist"
    },
    "app": {
        "windows": [
            {
                "label": "main",
                "title": "PDF 表格工坊",
                "width": 1280,
                "height": 850,
                "minWidth": 980,
                "minHeight": 680,
                "resizable": true
            }
        ],
        "security": {
            "csp": null
        }
    },
    "bundle": {
        "active": true,
        "createUpdaterArtifacts": true,
        "targets": [
            "dmg",
            "app",
            "nsis"
        ],
        "resources": {
            "resources/ocr-models/*": "ocr-models/"
        },
        "icon": [
            "icons/icon.png",
            "icons/icon.ico"
        ],
        "category": "Productivity",
        "shortDescription": "批量提取 PDF 表格并导出 Excel",
        "longDescription": "本地预览 PDF 并将表格转换为 Excel。",
        "windows": {
            "nsis": {
                "installMode": "currentUser",
                "displayLanguageSelector": true
            }
        }
    },
    "plugins": {
        "updater": {
            "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDlFOTEzQ0MyMThGQkRDQTMKUldTajNQc1l3anlSbnBJVG52bmtMaStWS2h4dnM2M2NMUzkvNnFMZE40Kzc2dWw1VXRNa0g2eU4K-rw-------",
            "endpoints": [
                "https://github.com/keerkeerhi/pdf2excel/releases/latest/download/latest.json"
            ]
        }
    }
}
